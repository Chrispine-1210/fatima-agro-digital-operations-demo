{
    "name": "fatima-agro-operations-demo",
    "version": "1.0.0-demo",
    "private": true,
    "engines": {
        "node": ">=22.13.0"
    },
    "scripts": {
        "install:ci": "npm ci --include=dev",
        "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
        "build": "node node_modules/vinext/dist/cli.js build",
        "prebuild": "node scripts/prepare-ocr-assets.mjs",
        "start": "node scripts/start-demo.mjs",
        "setup:demo": "node scripts/setup-demo.mjs",
        "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern fatima-agro-operations-demo --ignore-pattern node_modules.partial",
        "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
        "test": "node --experimental-strip-types --test tests/unit.test.mjs tests/portal-domain.test.mjs tests/portal-bootstrap.test.mjs tests/release-boundary.test.mjs tests/inventory-domain.test.mjs",
        "test:release": "node --test tests/release-artifacts.test.mjs",
        "test:components": "playwright test tests/e2e/customer.spec.ts",
        "test:rendered": "playwright test tests/e2e/customer.spec.ts --grep \"public direct routes\"",
        "test:browser": "playwright test",
        "audit:prod": "npm audit --omit=dev --audit-level=high",
        "scan:secrets": "node scripts/secret-scan.mjs",
        "db:generate": "node node_modules/drizzle-kit/bin.cjs generate"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@hookform/resolvers": "^5.7.1",
        "@shadcn/react": "^0.3.0",
        "@zxing/browser": "0.2.1",
        "@zxing/library": "0.23.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.4.0",
        "drizzle-orm": "0.45.2",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "jsbarcode": "3.12.3",
        "lucide-react": "^1.31.0",
        "next": "16.4.2",
        "next-themes": "^0.4.6",
        "radix-ui": "^1.6.7",
        "react": "19.2.8",
        "react-day-picker": "^10.0.1",
        "react-dom": "19.2.8",
        "react-hook-form": "^7.85.0",
        "react-resizable-panels": "^4.12.2",
        "recharts": "^3.8.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "3.6.0",
        "tesseract.js": "7.0.0",
        "tesseract.js-core": "7.0.0",
        "vaul": "^1.1.2",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "1.37.1",
        "@cloudflare/workers-types": "^4.20260515.0",
        "@playwright/test": "^1.55.0",
        "@tailwindcss/postcss": "4.2.1",
        "@tesseract.js-data/eng": "1.0.0",
        "@types/jsbarcode": "3.11.4",
        "@types/node": "22.19.19",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.2",
        "@vitejs/plugin-rsc": "0.5.26",
        "drizzle-kit": "0.31.10",
        "eslint": "9.39.4",
        "eslint-config-next": "16.4.2",
        "react-server-dom-webpack": "19.2.8",
        "tailwindcss": "4.2.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "5.9.3",
        "vinext": "0.0.50",
        "vite": "8.0.13",
        "wrangler": "4.92.0"
    },
    "overrides": {
        "source-map-js": "1.2.2",
        "fast-uri": "3.1.8",
        "vinext@0.0.50": {
            "image-size": "2.0.4"
        }
    },
    "type": "module",
    "displayName": "Fatima Agro Digital Operations Prototype"
}
