    "test:rendered": "node --test tests/rendered-html.test.mjs",
    "test:browser": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "db:generate": "drizzle-kit generate"
