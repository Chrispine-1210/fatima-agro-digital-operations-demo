# Hosted values are configured in Sites, not in this file or hosting.json.
# HQ_ADMIN_EMAILS: approved initial administrator addresses, comma separated.
# FATIMA_BOOTSTRAP_CEO_EMAILS: optional approved initial executive, distinct from administrators.
# FATIMA_BOOTSTRAP_OPERATIONS_DIRECTOR_EMAILS: optional approved initial operations reviewer.
# Bootstrap grants are recorded once per identity. Remove the lists after verified first sign-in.
# FATIMA_TRUSTED_HOST: optional exact Sites hostname override.
# Local rehearsal uses ignored .dev.vars generated by scripts/setup-demo.mjs.
# FATIMA_LOCAL_DEMO: true only on loopback development.
# FATIMA_LOCAL_SESSION_SECRET: random local HMAC key, never commit.
# No payment, email, payroll, tax-filing or delivery provider is connected.

# Fatima-managed account secrets: configure only through protected deployment settings.
FATIMA_PASSWORD_PEPPER=
FATIMA_ACCOUNT_BATCH_1=
FATIMA_ACCOUNT_BATCH_2=
FATIMA_ACCOUNT_BATCH_3=
